{
  "name": "poca-note",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "poca-note — a keyboard-first, tenant-scoped personal Kanban with AI actions and a content studio.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node scripts/start.mjs",
    "doctor": "node scripts/doctor.mjs",
    "docs": "node scripts/render-docs.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "tenant:create": "node scripts/create-tenant.js",
    "db:backup": "node scripts/backup-sqlite.js",
    "db:to-postgres": "node scripts/migrate-to-postgres.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
