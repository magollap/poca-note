# poca-note configuration — copy to .env and edit.
# All values are optional; sensible local defaults are used.

# Server
PORT=8787
# Public origin used for same-origin checks in production.
APP_ORIGIN=http://localhost:8787
# Set to 1 behind HTTPS so the session cookie is Secure.
COOKIE_SECURE=0

# Storage. SQLite is the default; set DATABASE_URL to switch to PostgreSQL.
# Migrate an existing SQLite database with:
#   npm run db:to-postgres -- --url "$DATABASE_URL"
DATABASE_PATH=./data/poca-note.db
# DATABASE_URL=postgresql://poca:password@127.0.0.1:5432/poca_note
# DATABASE_SSL=0
# DATABASE_TIMEOUT_MS=60000

# Sessions
SESSION_DAYS=30

# Seed tenant (created only when the database has no tenants)
DEMO_TENANT_SLUG=acme
DEMO_TENANT_NAME=Acme Studio
DEMO_TENANT_PASSWORD=poca-demo
# Show demo credentials on the login screen (defaults on outside production).
SHOW_DEMO_CREDENTIALS=1

# Self-service sign-up. Owners can add teammate logins from Settings.
REGISTRATION_OPEN=1
REGISTRATION_MAX_PER_HOUR=5

# Daily / weekly / monthly reports. Each workspace can keep several schedules;
# these environment values only seed the first daily/weekly/monthly schedule.
REPORTS_ENABLED=1
REPORTS_GRACE_MINUTES=120
REPORTS_TICK_MS=60000
REPORTS_DEFAULT_TIME=08:00
REPORTS_DEFAULT_TIMEZONE=UTC

# Link title lookup
LINK_FETCH_TIMEOUT_MS=6000
LINK_FETCH_MAX_BYTES=524288
# Only enable for local development/tests that must fetch private hosts.
ALLOW_PRIVATE_LINK_FETCH=0

# AI skills — Anthropic is preferred, then Ollama, then OpenAI-compatible.
# Provider and model names are server-side only; the UI shows "AI ready" or
# "Offline preview" and never exposes which model served a request.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
# auto | anthropic | ollama | openai | offline
AI_PROVIDER=auto
AI_TIMEOUT_MS=90000
